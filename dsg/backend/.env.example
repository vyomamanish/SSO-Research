# Don't copy this by hand: `npm run setup` in the repo root generates .env.
# Names follow dsg-sso.md section 8.
PORT=5001
# The demo's own MongoDB container, never a real DSG database.
MONGO_URI=mongodb://127.0.0.1:27018/dsg_demo
JWT_SECRET=change-me
SSO_MODE=sso_only
# The trailing slash is required: it must match the issuer Authentik publishes.
OIDC_ISSUER_URL=http://localhost:9000/application/o/dsg-dev/
OIDC_CLIENT_ID=dsg-dev
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
OIDC_REDIRECT_BASE=http://localhost:5173
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
OIDC_SCOPES=openid email profile dsg
OIDC_ROLES_CLAIM=dsg_roles
OIDC_STATE_SECRET=change-me
SSO_STAFF_SESSION_HOURS=8
OTT_URL=http://localhost:3000
