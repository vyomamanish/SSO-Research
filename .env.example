# Don't copy this by hand: `npm run setup` generates .env with real random values.
# This file documents what .env contains.

# Authentik (official compose variables)
PG_PASS=change-me
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# OTT's PostgreSQL database
OTT_DB_PASS=change-me

# Read by blueprints/vyoma-sso-demo.yaml via !Env
OTT_CLIENT_SECRET=change-me
DSG_CLIENT_SECRET=change-me
DEMO_ASHA_PASSWORD=change-me
DEMO_RAVI_PASSWORD=change-me
DEMO_PRIYA_PASSWORD=change-me
DEMO_MEERA_PASSWORD=change-me
DEMO_KIRAN_PASSWORD=change-me

# Optional: "Sign in with Google" (blueprints/google-source.yaml). Leave empty
# to hide the Google button. You fill these in yourself; setup never does.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
