# Don't copy this by hand: `npm run setup` generates .env with real random values.
# This file documents what .env contains.

# Authentik (official compose variables)
PG_PASS=change-me
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Read by blueprints/vyoma-sso-demo.yaml via !Env
OTT_CLIENT_SECRET=change-me
DSG_CLIENT_SECRET=change-me
DEMO_ADMIN_PASSWORD=change-me
DEMO_STAFF_PASSWORD=change-me
