# Don't copy this by hand: `npm run setup` generates .env.local with real values.
AUTH_URL=http://localhost:3001
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true
AUTH_AUTHENTIK_ID=ott-demo
AUTH_AUTHENTIK_SECRET=change-me
# The trailing slash is required: it must match the issuer Authentik publishes.
AUTH_AUTHENTIK_ISSUER=http://localhost:9000/application/o/ott-demo/
OTHER_APP_URL=http://localhost:3002
API_URL=http://localhost:4000
