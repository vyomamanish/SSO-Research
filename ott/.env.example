# Don't copy this by hand: `npm run setup` in the repo root generates .env.
# Names follow ott-sso.md section 12.
DATABASE_URL=postgresql://ott:change-me@localhost:5433/ott
# The trailing slash is required: it must match the issuer Authentik publishes.
AUTHENTIK_ISSUER=http://localhost:9000/application/o/vyoma-ott/
AUTHENTIK_CLIENT_ID=vyoma-ott-platform
AUTHENTIK_CLIENT_SECRET=change-me
SESSION_SECRET=change-me-64-hex-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
DSG_URL=http://localhost:5173
